{
  "name": "convos-loadtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend load-testing harness for the Convos iOS app. Fills a real device installation with dense content via convos-cli / node-sdk and sustains configurable churn.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "loadtest": "src/cli.ts"
  },
  "scripts": {
    "loadtest": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xmtp/convos-cli": "^0.10.15",
    "@xmtp/node-sdk": "^6.1.0",
    "p-limit": "^6.1.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
