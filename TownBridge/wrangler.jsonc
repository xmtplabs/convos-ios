{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convos-town-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESULT_MAILBOX",
        "class_name": "ResultMailbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ResultMailbox"]
    }
  ]
}
