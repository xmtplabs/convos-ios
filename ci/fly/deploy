#!/bin/bash
#
# Deploy XMTP test infrastructure to Fly.io
#
# Usage:
#   ./ci/fly/deploy [APP_NAME]
#
# If APP_NAME is not provided, generates one using timestamp.
#
# Outputs (to stdout):
#   app_name=<name>
#   node_url=<url>
#   history_url=<url>
#
# Environment:
#   FLY_API_TOKEN - Required for Fly.io authentication
#   FLY_ORG       - Organization to deploy to (default: xmtp-labs)
#   FLY_REGION    - Region to deploy to (default: iad)

set -e
export FLYCTL_NO_PROMPT=1

# Validate required environment variables
if [ -z "$FLY_API_TOKEN" ]; then
    echo "Error: FLY_API_TOKEN is not set" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Note: machine-config.json contains hardcoded credentials (postgres passwords, node keys)
# These are intentionally non-secret as they're only used for ephemeral CI test environments
MACHINE_CONFIG="${SCRIPT_DIR}/machine-config.json"

FLY_ORG="${FLY_ORG:-xmtp-labs}"
FLY_REGION="${FLY_REGION:-iad}"

# Generate or use provided app name
if [ -n "$1" ]; then
    APP_NAME="$1"
else
    APP_NAME="convos-ios-test-$(date +%s)"
fi

echo "Creating app: $APP_NAME" >&2

# Create the app; if it already exists continue, otherwise surface the real
# error. Existence is checked via `apps list` (there is no `apps show` command
# in flyctl, and an unknown subcommand prints help and exits 0 - which would
# mask real create failures like overdue billing or missing permissions as a
# false "already exists"). Match the app name against the first column exactly
# so a substring like "foo" doesn't match an unrelated "foo-prod".
if ! CREATE_OUT="$(flyctl apps create "$APP_NAME" --org "$FLY_ORG" 2>&1)"; then
    if flyctl apps list 2>/dev/null | awk -v name="$APP_NAME" '$1 == name { found = 1 } END { exit !found }'; then
        echo "App already exists, continuing: $APP_NAME" >&2
    else
        echo "Failed to create app: $APP_NAME" >&2
        echo "$CREATE_OUT" >&2
        exit 1
    fi
fi

# Allocate IP addresses for the app (ignore if already allocated)
echo "Allocating IP addresses..." >&2
flyctl ips allocate-v4 --shared --app "$APP_NAME" 2>/dev/null || true
flyctl ips allocate-v6 --app "$APP_NAME" 2>/dev/null || true

# Deploy multi-container machine
echo "Deploying multi-container machine..." >&2
flyctl machine run \
    --app "$APP_NAME" \
    --region "$FLY_REGION" \
    --rm \
    --restart no \
    --machine-config "$MACHINE_CONFIG"

# Wait for TLS to be ready
APP_HOSTNAME="${APP_NAME}.fly.dev"
MAX_TLS_ATTEMPTS=60
TLS_ATTEMPT=0

echo "Waiting for TLS to be ready..." >&2
# `CONNECTED` is printed by s_client the moment the TCP socket opens, before
# the handshake is attempted, so matching on it reported success against a
# port that had merely started accepting connections. `New, TLS...` is only
# printed once a handshake actually completes - verified against both a live
# TLS host and a plain-HTTP port, where `Verify return code:` still appears
# and so is no good either.
while [[ $TLS_ATTEMPT -lt $MAX_TLS_ATTEMPTS ]]; do
    if openssl s_client -connect "$APP_HOSTNAME:443" -servername "$APP_HOSTNAME" -alpn h2 \
        </dev/null 2>/dev/null | grep -q "^New, TLS"; then
        echo "TLS is ready!" >&2
        break
    fi

    TLS_ATTEMPT=$((TLS_ATTEMPT + 1))
    echo "  Attempt $TLS_ATTEMPT/$MAX_TLS_ATTEMPTS - waiting for TLS..." >&2
    sleep 2
done

if [[ $TLS_ATTEMPT -ge $MAX_TLS_ATTEMPTS ]]; then
    echo "Error: TLS failed to become ready within timeout" >&2
    exit 1
fi

# Wait for the gRPC service to answer. Port 443 fronts internal 5556 with
# ALPN h2 (see machine-config.json), so an HTTP/2 POST reaches the gRPC
# server directly.
#
# The request has to carry a well-formed gRPC message or the server will sit
# waiting for one and never respond. A gRPC frame is a 1-byte compression
# flag followed by a 4-byte big-endian length, so five zero bytes is a valid
# empty message. The previous probe sent no body at all, so every attempt hung
# until curl's own timeout and reported `000` (exit 28) - not a TLS or routing
# failure, just a request the server was still waiting to finish. That read as
# "not ready" for all 30 attempts of every run sampled, a hard 150s cost for a
# signal that could never arrive, after which the deploy continued anyway.
#
# With the frame the server replies `HTTP/2 200` plus `grpc-status: 0`, so
# this now exits as soon as the node is genuinely serving. The bytes go via a
# file because a NUL cannot survive in a bash variable.
#
# `|| echo "000"` also used to run *in addition to* curl's own `000` output,
# concatenating into the nonsense `HTTP 000000` in those logs; the subshell
# exit is swallowed instead so the real code is reported.
MAX_GRPC_ATTEMPTS=60
GRPC_INTERVAL=2
GRPC_ATTEMPT=0
GRPC_READY=0

GRPC_FRAME="$(mktemp)"
trap 'rm -f "$GRPC_FRAME"' EXIT
printf '\x00\x00\x00\x00\x00' > "$GRPC_FRAME"

echo "Waiting for gRPC service to be ready..." >&2
while [[ $GRPC_ATTEMPT -lt $MAX_GRPC_ATTEMPTS ]]; do
    HTTP_CODE="$(curl -s -o /dev/null -w "%{http_code}" \
        --http2 \
        -H "Content-Type: application/grpc" \
        -H "TE: trailers" \
        --data-binary "@$GRPC_FRAME" \
        -X POST \
        "https://${APP_HOSTNAME}:443/xmtp.identity.api.v1.IdentityApi/GetInboxIds" \
        --max-time 5 2>/dev/null)" || true
    HTTP_CODE="${HTTP_CODE:-000}"

    if [[ "$HTTP_CODE" == "200" ]]; then
        echo "gRPC service is ready! (HTTP 200 after $GRPC_ATTEMPT retries)" >&2
        GRPC_READY=1
        break
    fi

    GRPC_ATTEMPT=$((GRPC_ATTEMPT + 1))
    echo "  Attempt $GRPC_ATTEMPT/$MAX_GRPC_ATTEMPTS - HTTP $HTTP_CODE, waiting..." >&2
    sleep "$GRPC_INTERVAL"
done

if [[ $GRPC_READY -ne 1 ]]; then
    echo "Warning: gRPC readiness check never got HTTP 200, proceeding anyway" >&2
fi

XMTP_URL="https://${APP_HOSTNAME}:443"

echo "" >&2
echo "Deployment complete!" >&2
echo "" >&2

# Output results for GitHub Actions
echo "app_name=$APP_NAME"
echo "xmtp_node_address=$XMTP_URL"
echo "xmtp_is_secure=true"

# Also write to GITHUB_OUTPUT if available
if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    echo "app_name=$APP_NAME" >> "$GITHUB_OUTPUT"
    echo "xmtp_node_address=$XMTP_URL" >> "$GITHUB_OUTPUT"
    echo "xmtp_is_secure=true" >> "$GITHUB_OUTPUT"
fi
